///////////////////////////////////////////////////////////////////////Program Setup Fuction
void setup() {

  // prepare GPIO's
  pinMode(D_PIN_FILTER, OUTPUT);
  pinMode(D_PIN_BUBBLE, OUTPUT);

  digitalWrite(D_PIN_FILTER, LOW);
  digitalWrite(D_PIN_BUBBLE, LOW);

  Serial.begin(9600);
  delay(50);


  readEEPROM();
  setUpDS18B20();
  setupAPWifi();
  setupWifi();
  startServer();
  setUpOTA();
  mqttSetup();
//  FirebaseSetup();

  start_NTP_UDP();
}

//////////////////////////////////////////////////////////////////////////////Loop Function
void loop() {
  
  server.handleClient();
  ArduinoOTA.handle();

  ////////mqtt connect section
  MQTTConnecting();

  uint16_t last_time = NTP_Handle();

  AquariumDO(last_time);
  
  if (T.Wait(3600000)) {
    readTemp();
  }
  
}
