///////////////////////////////////////////////////////////////////////EEPROM Read
void EEPROM_read_param() {
  ////////////////////////////////////////////////////////////EEPROM Read Min Temp
  #if !DEBUG
  G_MinTemp = CF_EEPROM_reed_string(D_eepromMinTemp).toFloat();
  ////////////////////////////////////////////////////////////EEPROM Read Min Temp
  G_MaxTemp = CF_EEPROM_reed_string(D_eepromMaxTemp).toFloat();
  #endif
  /////////////////////////////////////////////////////////////////////////////////
  Serial.println("\n\n\n"); SFPRINT("EE minTemp = "); Serial.println(G_MinTemp); SFPRINT("EE maxTemp = "); Serial.println(G_MaxTemp);
  ////////////////////////////////////////////////////////////EEPROM SSID
}
