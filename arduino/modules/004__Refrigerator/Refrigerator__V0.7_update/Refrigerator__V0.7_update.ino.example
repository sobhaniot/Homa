constexpr int D_eepromMinTemp[]          = {150,10};
constexpr int D_eepromMaxTemp[]          = {160,10};

//#define Serial             if(DEBUG)Serial

float       G_TempIn                  = 0;
float       G_TempOut                 = 0;
int         G_OnTime                  = 0;
int         G_OffTime                 = 0;

///////////////////////////////////////////////////////////////////////Program Setup Fuction
void setup() {

  // prepare GPIO's
  pinMode(D_PIN_LEDIN, OUTPUT);
  pinMode(D_PIN_CHECKDOOR, INPUT_PULLUP);
  pinMode(D_PIN_MOTOR, OUTPUT);

  digitalWrite(D_PIN_LEDIN, LOW);
  digitalWrite(D_PIN_MOTOR, LOW);

  Serial.begin(115200);
  delay(50);


  CF_EEPROM_SetUp(256);
  EEPROM_read_param();
  My_setUpDS18B20();
  CF_setupAPWifi();
  CF_startServer();
  CF_startWebSocket();
  CF_MQTTSetup(256);
  CF_mdnsSetup();

  setUpLCD();
  WellComing();

  TickerAllDo.attach(1, WaitCounting);
}

//////////////////////////////////////////////////////////////////////////////Loop Function
void loop() {
  MDNS.update();
  webSocket.loop();

  ////////wifi mqtt connect section
  CF_WifiLoop(); 
  CF_MQTTLoop(); 

  CheckDoor();
  checkAlarm();

  switch (G_Flag_First_PlugIn) {
    case 1:
      TickerAllDo.attach_ms(50, RemoveWellComing);
      SFPRINTLN("RemoveWellComing");
      G_Flag_First_PlugIn = 2;
      break;

    case 3:
      TickerAllDo.attach(10, [](){G_Flag_First_PlugIn = 4;});
      G_Flag_First_PlugIn = 4;
      break;

    case 4:
      #if DEBUG
      G_TempIn = My_readTemp(0);
      #else
      G_TempIn = My_readTemp(1);
      #endif
      G_TempOut = My_readTemp(0);

      refrigeratorDO();

      CheckTempHigh();

      showOnLCD(G_TempIn, G_TempOut, G_OnTime, G_OffTime);
      SFPRINT("AllDo");
      SFPRINT("     ");
      Serial.println(DoorCondition);
      G_Flag_First_PlugIn = 5;
      break;
  }
 
}
