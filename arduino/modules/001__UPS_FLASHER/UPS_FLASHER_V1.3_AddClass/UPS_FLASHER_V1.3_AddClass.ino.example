/////////////////////////////////////////////////////////////////////////Program Setup Fuction
void setup() {

  // prepare GPIO's
  pinMode(PinLED, OUTPUT);
  pinMode(CheckPin, INPUT);
  pinMode(relayModemPin, OUTPUT);
  pinMode(relayCameraPin, OUTPUT);

  digitalWrite(PinLED, HIGH);
  digitalWrite(relayModemPin, HIGH);
  digitalWrite(relayCameraPin, HIGH);

  //  Serial.begin(115200);
  delay(50);

  readEEPROM();
  setupAPWifi();
  setupWifi();
  startServer();
  setUpOTA();
  mqttSetup();
  FirebaseSetup();
}

unsigned long previousTime = millis();
//////////////////////////////////////////////////////////////////////////////Loop Function
void loop() {
  server.handleClient();
  ArduinoOTA.handle();

  ////////mqtt connect section
  MQTTConnecting();


  PowerConditionReport();
  
  LampDo();
  
}
