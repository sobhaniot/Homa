///////////////////////////////////////////////////////////////////////Program Setup Fuction
void setup() {

  // prepare GPIO's
  pinMode(D_PIN_Gas, INPUT);
  pinMode(D_PIN_TEMP, INPUT);

  Serial.begin(9600);
  delay(50);


  readEEPROM();
  setUpDS18B20();
  setupAPWifi();
  setupWifi();
  startServer();
  setUpOTA();
  mqttSetup();
  FirebaseSetup();

  start_NTP_UDP();
}

//////////////////////////////////////////////////////////////////////////////Loop Function
void loop() {

  server.handleClient();
  ArduinoOTA.handle();

  ////////mqtt connect section
  MQTTConnecting();

  uint16_t last_time = NTP_Handle();

  if (T.Wait(30000)) {
    recordDailyGasTemp(last_time);
    handleDailyReport(last_time);
  }

  

  if (TF.Wait(50000)) {
    GasTempDO(last_time);
  }

}
